<div class="container mt-5">
    <h1>Painel Administrativo</h1>
    <p>Usuário: <%= user.username %> (papel: <%= user.role %>)</p>

    <div class="row">
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total de veículos</h5>
                <p class="display-4"><%= metrics.totalVeiculos %></p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Veículos vendidos</h5>
                <p class="display-4"><%= metrics.vendidos %></p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Veículos disponíveis</h5>
                <p class="display-4"><%= metrics.disponiveis %></p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Conversas</h5>
                <p class="display-4"><%= metrics.conversas %></p>
            </div>
        </div>
    </div>
</div>
