<% if (typeof flash !== 'undefined' && flash && flash.message) { %>
    <div aria-live="polite" aria-atomic="true" style="position: fixed; top: 20px; right: 20px; z-index: 1080; min-width: 320px;">
        <div id="flashToast" class="toast fade show bg-white border border-<%= flash.type === 'success' ? 'success' : 'danger' %> shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-delay="5000">
            <div class="toast-header bg-<%= flash.type === 'success' ? 'success' : 'danger' %> text-white">
                <strong class="mr-auto">
                    <%= flash.type === 'success' ? '✓ Sucesso' : '✕ Erro' %>
                </strong>
                <button type="button" class="ml-2 mb-1 close text-white" data-dismiss="toast" aria-label="Fechar" style="outline: none;">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="toast-body text-dark font-weight-bold">
                <%= flash.message %>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof $ !== 'undefined' && $.fn.toast) {
                $('#flashToast').toast({ delay: 5000 });
                $('#flashToast').toast('show');
            }
        });
    </script>
<% } %>
